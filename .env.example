PH_LLM_PROVIDER=openai
PH_LLM_MODEL=gpt-4o-mini
PH_LLM_BASE_URL=
PH_OPENAI_API_KEY=sk-...
PH_ANTHROPIC_API_KEY=
PH_DRY_RUN=true
PH_REQUIRE_AUTHORIZATION=true
PH_MAX_TOTAL_REQUESTS=200
PH_MAX_STEPS=20

# External scanner tools (nuclei/ffuf/sqlmap) — off by default. A second,
# independent gate on top of dry_run/scope_guard; these shell out to real
# binaries that must already be installed and on PATH.
PH_ENABLE_EXTERNAL_TOOLS=false
PH_EXTERNAL_TOOL_TIMEOUT=60
PH_NUCLEI_BIN=nuclei
PH_FFUF_BIN=ffuf
PH_SQLMAP_BIN=sqlmap
